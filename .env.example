# Copy to .env (never commit .env). One file at the repository root is used by the server.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (or a local mongodb://127.0.0.1:27017/travelos)
MONGODB_URI=<YOUR_MONGODB_ATLAS_URI>
# Optional comma-separated DNS servers for Node.js SRV resolution (for example: 8.8.8.8,8.8.4.4)
MONGODB_DNS_SERVERS=

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
JWT_EXPIRES_IN_HOURS=8
BCRYPT_ROUNDS=12

# Comma-separated list of allowed browser origins (required in production)
CLIENT_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Seeding (dev only). Optional override of the shared demo password; refused in production unless ALLOW_PROD_SEED=true
SEED_DEFAULT_PASSWORD=
ALLOW_PROD_SEED=false

# AI (Phase 5). "mock" works with no key.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# Cloudinary (Phase 3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
