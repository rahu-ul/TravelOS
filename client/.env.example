# TravelOS Frontend Environment Configuration (Vite)
#
# In local development:
# Leave VITE_API_URL blank (or omit). Vite automatically proxies '/api' to http://localhost:5000.
#
# In production on Vercel:
# Configure this in your Vercel Project Settings -> Environment Variables:
VITE_API_URL=https://travelos-backend-ksib.onrender.com

