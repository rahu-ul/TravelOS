# TravelOS Backend Environment Configuration (Express + MongoDB)
# Copy to .env in repository root or in server/ directory

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (or local mongodb://127.0.0.1:27017/travelos)
# Tip: Ensure database name 'travelos' is included before the query parameters
MONGODB_URI=YOUR_MONGODB_URI

# Optional: Override/specify the database name (defaults to 'travelos')
MONGODB_DB_NAME=travelos

# Optional comma-separated DNS servers for SRV resolution
MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4

# At least 32 random characters for JWT signing
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRES_IN_HOURS=8
BCRYPT_ROUNDS=12

# Comma-separated list of allowed frontend origins (CORS)
# Local: http://localhost:5173 | Production: https://travel-os-indol.vercel.app
CLIENT_ORIGIN=http://localhost:5173,https://travel-os-indol.vercel.app

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Demo Seeding (optional, development only; never enabled in production)
SEED_DEFAULT_PASSWORD=YOUR_ADMIN_PASSWORD
ALLOW_PROD_SEED=false

# AI Assistant ("mock" works locally without external API key)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# Cloudinary (optional for production image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

